# Diarizer service (host-native — runs like Ollama, NOT in Docker).
DIARIZER_PORT=8090
# HuggingFace token for the gated pyannote model. Create a free account, accept
# terms at https://hf.co/pyannote/speaker-diarization-3.1, then paste the token.
# Inference stays 100% local; only the one-time model download needs it.
HF_TOKEN=
# faster-whisper model. Runs CPU/int8 on Apple Silicon (CTranslate2 has no Metal).
DIARIZER_WHISPER_MODEL=medium
# Torch device for pyannote: auto (mps if available else cpu), cpu, mps, cuda.
DIARIZER_DEVICE=auto
# Reuse Whishper's CT2 model cache so whisper weights aren't stored twice.
# Relative to diarizer/ (where the service runs), so ../ points at repo root.
DIARIZER_MODEL_CACHE=../whishper_data/models
