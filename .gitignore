# Runtime data: mongo db, uploads, logs, libretranslate, downloaded whisper
# models. Can be large (multi-GB) and is machine-local — never commit it.
whishper_data/

# Formatter profiles (editable style profiles) — machine-local.
formatter_data/

# Local config (copy from .env.example). Keeps your own creds/ports out of git.
.env

# Python: bytecode caches and virtualenvs (e.g. diarizer/.venv, which holds a
# multi-GB torch/pyannote stack — never commit it).
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
